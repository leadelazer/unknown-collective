{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite",
    "dev:studio": "npm run dev --prefix studio",
    "dev:all": "concurrently -n SITE,STUDIO -c auto \"npm run dev:site\" \"npm run dev:studio\"",
    "kill:dev-ports": "lsof -ti :3099 :5200 :5173 2>/dev/null | xargs kill -9 2>/dev/null || true",
    "dev:studio:clean": "lsof -ti :3099 :5200 2>/dev/null | xargs kill -9 2>/dev/null || true && npm run dev:studio",
    "dev:all:clean": "npm run kill:dev-ports && npm run dev:all",
    "prebuild": "node scripts/optimize-portraits.mjs",
    "build": "vite build",
    "build:studio": "npm run build --prefix studio",
    "build:all": "npm run build && npm run build:studio",
    "lint": "eslint .",
    "preview": "vite preview",
    "optimize:portraits": "node scripts/optimize-portraits.mjs",
    "sync-bios": "node src/data/sync-bios.js",
    "sync-all": "node src/data/sync-all.js"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.4"
  }
}
